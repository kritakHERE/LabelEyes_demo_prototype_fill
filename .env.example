# GEMINI_API_KEY: Required for optional Deeper Explain (Gemini High Thinking) calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="http://localhost:3000"

# Google Maps Platform API Key (injected automatically in AI Studio preview)
VITE_GOOGLE_MAPS_API_KEY=""

# LabelEyes Configuration
DEMO_MODE="true"
FREE_OCR_SCANS_PER_MONTH="3"
GUEST_OCR_SCANS_LIMIT="1"
OCR_MODE="local"
SESSION_SECRET="change-me-in-production-labeleyes"
OBF_USER_AGENT="LabelEyes/1.0 (https://labeleyes.example)"
